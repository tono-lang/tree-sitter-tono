{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tono",
      "camelcase": "Tono",
      "scope": "source.tono",
      "path": ".",
      "file-types": ["tono"],
      "highlights": ["queries/highlights.scm"],
      "injection-regex": "^tono$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "Tono grammar for tree-sitter",
    "authors": [
      {
        "name": "gandarfh",
        "email": "joao@httui.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tono-lang/tree-sitter-tono"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false
  }
}
