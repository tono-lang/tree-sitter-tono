ext configlib {
// <- keyword
//  ^ module
  go { #(github.com/example/configlib) }
//^ property
//     ^ string.special

  struct go_config { Host: string, Env: string  go { #(Config) } }
//^ keyword
//       ^ type
//                   ^ property
//                         ^ type.builtin
//                                              ^ property
//                                                   ^ string.special

  struct publisher {
//^ keyword
//       ^ type
    go { #(*Publisher) }
//  ^ property
//       ^ string.special
    @async(rust)
//   ^ attribute
    op send(topic: string): ack {
//  ^ keyword
//     ^ function
//          ^ variable.parameter
//                          ^ type
      go {
//    ^ property
        call: #(Send)(#(ctx context.Context), topic)
//      ^ keyword
//            ^ string.special
//                    ^ string.special
//                                            ^ variable.parameter
        yields: (err: error, a: go_ack)
//      ^ keyword
//               ^ variable
//                    ^ type.builtin
//                           ^ variable
//                              ^ type
        returns: ack { id: .a.ID }
//      ^ keyword
//               ^ type
//                     ^ property
//                          ^ property
      }
      rust {
        call: #(Publisher::send)(topic: #(&str))
//            ^ string.special
//                                ^ variable.parameter
//                                       ^ string.special
      }
    }
  }
}

pub struct client {
  config: app_config = configlib.load(.service, .region)
//^ property
//                     ^ module
//                               ^ function.call
//                                     ^ property
}
